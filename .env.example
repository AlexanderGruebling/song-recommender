# ------------------------------------------------------------------
# FM4 Top 40 Downloader configuration
# Copy this file to `.env` and adjust the values. Never commit `.env`.
# ------------------------------------------------------------------

# ---- Server ------------------------------------------------------
# Host/port the web app binds to. 0.0.0.0 exposes it on your LAN.
HOST=0.0.0.0
PORT=8000

# ---- Data --------------------------------------------------------
# Directory that holds the SQLite database file and other runtime data.
DATA_DIR=./data
# SQLite database URL. Defaults to <DATA_DIR>/fm4top40.db.
# DATABASE_URL=sqlite:///./data/fm4top40.db

# ---- FM4 chart discovery -----------------------------------------
# How often the app checks for newly published charts.
FM4_POLL_INTERVAL=6h
# Tag page that links to the individual chart articles.
FM4_TAG_URL=https://fm4.orf.at/tag/Musik/FM4%20Charts
# HTTP timeout in seconds for FM4 requests.
FM4_REQUEST_TIMEOUT=20
# How many chart story links to inspect per refresh run.
FM4_MAX_CHARTS_PER_RUN=16

# ---- YouTube -----------------------------------------------------
# Required. Create a key in the Google Cloud Console (YouTube Data API v3).
# YOUTUBE_API_KEY=your-key-here
# How many raw results to fetch from the YouTube search API.
YOUTUBE_MAX_RESULTS=10
# How many ranked candidates to present to the user.
YOUTUBE_CANDIDATES=3

# ---- Downloads ---------------------------------------------------
# Directory where downloaded files are stored.
DOWNLOAD_DIRECTORY=./music
# Path to the yt-dlp executable.
YTDLP_PATH=yt-dlp
# yt-dlp format selection. The default extracts the best audio source
# into a high-quality mp3, which is ideal for a personal music library.
YTDLP_FORMAT=bestaudio/best
# Set to true to extract audio into YTDLP_AUDIO_FORMAT.
YTDLP_EXTRACT_AUDIO=true
YTDLP_AUDIO_FORMAT=mp3
# Audio quality: 0 = best, 9 = worst.
YTDLP_AUDIO_QUALITY=0
# Maximum number of simultaneous yt-dlp downloads.
DOWNLOAD_CONCURRENCY=1

# ---- Logging -----------------------------------------------------
LOG_LEVEL=INFO